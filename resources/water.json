{
  "schema_version": "1.0",
  "id": "water",
  "name": {
    "zh": "水",
    "en": "Water"
  },
  "category": "substance",
  "description": "化学物质 H₂O。本条记录同一物质的液相、固相和气相。天然水体与水汽所在的空气可含其他成分。",
  "composition": {
    "formula": "H2O",
    "source_ids": [
      "nist"
    ]
  },
  "appearance": {
    "phase": "liquid",
    "description": "常见液态形态为透明液体。雪、冰和水汽分别是同一物质的固态或气态表现，天然样本可能含其他成分。"
  },
  "properties": [],
  "formation": "水穿过空气、地表和地下各水库。蒸发将液态水转成水汽，凝结以及降水改变其所在位置，积雪与冰可经融化补给地表水。",
  "storage": "自然水库包括空气、积雪和冰体、地表水与含水层，储存相态随环境变化。",
  "applications": [
    "溶剂"
  ],
  "acquisition": [
    {
      "kind": "processing",
      "operation": "distill",
      "description": "蒸馏将含水混合物中的一部分水转为蒸汽并收集冷凝液。某些挥发性杂质仍可能随之进入冷凝液，纯度需按样本验证。",
      "conditions": [
        "需要受控加热及冷凝"
      ],
      "inputs": [
        {
          "resource_id": "raw_water",
          "description": "含水混合物"
        }
      ],
      "equipment": [
        "蒸馏装置",
        "冷凝装置",
        "接收容器"
      ],
      "source_ids": [
        "distillation",
        "cdc_distillation"
      ]
    }
  ],
